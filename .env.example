POSTGRES_USER=dms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dms
DATABASE_URL=postgresql+asyncpg://dms:change_me@db:5432/dms
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FCM_CREDENTIALS_FILE=/run/secrets/firebase.json

# Run the dedicated worker; enable embedded mode only when no worker process is used.
EMBEDDED_WORKER=false
METRICS_RETENTION_DAYS=7
HOURLY_RETENTION_DAYS=90
# Enable only after configuring Firebase credentials and client registration.
FCM_ENABLED=false
